{
  "name": "xerlock",
  "description": "XERlock — self-hosted, read-only Primavera P6 .xer and Microsoft Project review tool: Gantt, critical path, health checks, progress, compare",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc --noEmit -p .",
    "build:standalone": "node scripts/prepare-standalone.mjs && vue-tsc --noEmit -p . && vite build --mode standalone --outDir dist-standalone",
    "dev:standalone": "node scripts/prepare-standalone.mjs && vite --mode standalone"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dagre": "^0.8.5",
    "exceljs": "^4.4.0",
    "pyodide": "^314.0.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
