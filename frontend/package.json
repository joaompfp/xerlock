{
  "name": "xerlock",
  "description": "XERlock \u2014 self-hosted, read-only Primavera P6 .xer review tool: Gantt, critical path, health checks, progress, compare",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dagre": "^0.8.5",
    "exceljs": "^4.4.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
